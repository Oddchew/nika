concept_bodhi
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[бодхи]
	(* <- lang_ru;; *);
	[Bodhi]
	(* <- lang_en;; *);
=> nrel_note:
	[Бодхи — пробуждение, просветление. Состояние полного понимания Четырёх благородных истин и природы реальности.]
	(* <- lang_ru;; *);
=> nrel_definition:
	[Бодхи — интуитивное постижение истины, ведущее к освобождению от неведения и достижению нирваны. Исторический Будда достиг бодхи под деревом Бодхи.]
	(* <- lang_ru;; *);
<= nrel_leads_to: concept_nirvana;
=> nrel_related: concept_enlightenment;;
