concept_meditation
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[медитация]
	(* <- lang_ru;; *);
	[Meditation]
	(* <- lang_en;; *);
=> nrel_note:
	[Медитация (бхавана, дхьяна) — ключевая практика буддизма, направленная на развитие сосредоточения и мудрости.]
	(* <- lang_ru;; *);
=> nrel_definition:
	[Медитация — систематическая тренировка ума, включающая развитие спокойствия (шаматха) и прозрения (випашьяна).]
	(* <- lang_ru;; *);
<= nrel_part_of: concept_noble_eightfold_path;
<= nrel_leads_to: concept_bodhi;;
