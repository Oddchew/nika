concept_dukkha
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[дуккха]
	(* <- lang_ru;; *);
	[Dukkha]
	(* <- lang_en;; *);
=> nrel_note:
	[Дуккха — одно из ключевых понятий буддизма. Обычно переводится как «страдание», но более точно означает неудовлетворённость, беспокойство, фрустрацию, связанную с непостоянством всех явлений.]
	(* <- lang_ru;; *);
=> nrel_definition:
	[Дуккха — первая из Четырёх благородных истин. Означает, что всё обусловленное существование проникнуто неудовлетворённостью.]
	(* <- lang_ru;; *);
<= nrel_part_of: concept_four_noble_truths;
<= nrel_contains: concept_samsara;;
