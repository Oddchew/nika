concept_anicca
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[аничча]
	(* <- lang_ru;; *);
	[Anicca]
	(* <- lang_en;; *);
=> nrel_note:
	[Аничча — непостоянство. Один из трёх признаков существования. Всё составное подвержено возникновению и исчезновению.]
	(* <- lang_ru;; *);
=> nrel_definition:
	[Аничча — учение о всеобщем непостоянстве. Все обусловленные явления возникают, существуют и разрушаются.]
	(* <- lang_ru;; *);
<= nrel_part_of: concept_dharma;;
