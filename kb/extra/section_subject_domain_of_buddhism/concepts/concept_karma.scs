concept_karma
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[карма]
	(* <- lang_ru;; *);
	[Karma]
	(* <- lang_en;; *);
=> nrel_note:
	[Карма (санскр. «действие») — закон причины и следствия. Любое намеренное действие (телесное, словесное, умственное) порождает последствия, влияющие на будущие перерождения.]
	(* <- lang_ru;; *);
=> nrel_definition:
	[Карма — волевое действие, которое создаёт отпечатки в потоке сознания и обусловливает характер последующих рождений в сансаре.]
	(* <- lang_ru;; *);
=> nrel_causes: concept_samsara;
<= nrel_part_of: concept_dharma;;
