concept_buddha
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[будда]
	(* <- lang_ru;; *);
	[Buddha]
	(* <- lang_en;; *);
=> nrel_note:
	[Будда (санскр. «пробуждённый», «просветлённый») — титул существа, достигшего высшего духовного совершенства и освобождения от страданий. В узком смысле — исторический Будда Шакьямуни.]
	(* <- lang_ru;; *);
=> nrel_definition:
	[Будда — существо, полностью реализовавшее Четыре благородные истины, достигшее нирваны и способное указывать путь к освобождению другим существам.]
	(* <- lang_ru;; *);
<= nrel_inclusion: concept_person;
=> nrel_inclusion: concept_arhat;;
