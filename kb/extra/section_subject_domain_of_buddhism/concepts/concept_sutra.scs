concept_sutra
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[сутра]
	(* <- lang_ru;; *);
	[Sutra]
	(* <- lang_en;; *);
=> nrel_note:
	[Сутра — текст, содержащий слова Будды или его ближайших учеников. Основной жанр буддийской канонической литературы.]
	(* <- lang_ru;; *);
=> nrel_definition:
	[Сутра — канонический текст, передающий учение Будды. Важнейшие сутры входят в состав Трипитаки.]
	(* <- lang_ru;; *);
<= nrel_part_of: concept_dharma;;
