concept_theravada
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[тхеравада]
	(* <- lang_ru;; *);
	[Theravada]
	(* <- lang_en;; *);
=> nrel_note:
	[Тхеравада («учение старейшин») — старейшая сохранившаяся школа буддизма. Распространена в Шри-Ланке, Таиланде, Мьянме, Лаосе и Камбодже. Ориентирована на монашескую практику и достижение архатства.]
	(* <- lang_ru;; *);
=> nrel_definition:
	[Тхеравада — направление буддизма, опирающееся на Палийский канон и считающее своей целью достижение состояния архата.]
	(* <- lang_ru;; *);
<= nrel_inclusion: concept_buddhist_school;
<= nrel_part_of: concept_buddhism;;
