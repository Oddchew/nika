concept_anatta
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[анатта]
	(* <- lang_ru;; *);
	[Anatta]
	(* <- lang_en;; *);
=> nrel_note:
	[Анатта (санскр. анатман) — доктрина отсутствия постоянной, неизменной души или «я». Одно из трёх признаков существования наряду с аниччей и дуккхой.]
	(* <- lang_ru;; *);
=> nrel_definition:
	[Анатта — учение о том, что ни в личности, ни во внешних явлениях нет неизменной сущности (атмана). Всё является совокупностью изменяющихся дхарм.]
	(* <- lang_ru;; *);
<= nrel_part_of: concept_dharma;;
