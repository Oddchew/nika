concept_noble_eightfold_path
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[Благородный восьмеричный путь]
	(* <- lang_ru;; *);
	[Noble Eightfold Path]
	(* <- lang_en;; *);
=> nrel_note:
	[Практический путь прекращения страдания, указанный в четвёртой благородной истине. Делится на три раздела: мудрость (праджня), нравственность (шила) и сосредоточение (самадхи).]
	(* <- lang_ru;; *);
=> nrel_definition:
	[Путь, состоящий из восьми взаимосвязанных факторов: правильное воззрение, правильное намерение, правильная речь, правильные поступки, правильный образ жизни, правильное усилие, правильная осознанность и правильное сосредоточение.]
	(* <- lang_ru;; *);
<= nrel_part_of: concept_four_noble_truths;
<= nrel_leads_to: concept_nirvana;
=> nrel_based_on: concept_middle_way;;
