nrel_founder
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[основатель*]
	(* <- lang_ru;; *);
	[founder*]
	(* <- lang_en;; *);
=> nrel_first_domain: concept_person;
=> nrel_second_domain: concept_buddhism;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination: {
			concept_person;
			concept_buddhism
		};;
	*);
=> nrel_note:
	[Бинарное ориентированное отношение, связывающее личность и основанное ею учение или религию.]
	(* <- lang_ru;; *);
=> nrel_definition:
	[Отношение «быть основателем*» связывает человека с учением или религией, которую он основал.]
	(* <- lang_ru;; *);;
