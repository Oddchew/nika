nrel_teaches
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
=> nrel_main_idtf:
	[преподаёт*]
	(* <- lang_ru;; *);
	[teaches*]
	(* <- lang_en;; *);
=> nrel_first_domain: concept_buddha;
=> nrel_second_domain: concept_dharma;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination: {
			concept_buddha;
			concept_dharma
		};;
	*);
=> nrel_note:
	[Отношение, связывающее учителя (Будду) с тем, чему он учит (Дхармой, истинами, путём).]
	(* <- lang_ru;; *);;
